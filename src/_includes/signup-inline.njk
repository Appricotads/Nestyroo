<form name="deal-alerts-inline" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="signup-inline">
  <input type="hidden" name="form-name" value="deal-alerts-inline">
  <input type="hidden" name="consent" value="Agreed by subscribing">
  <p class="hidden-field"><label>Leave blank: <input name="bot-field"></label></p>
  <label class="sr-only" for="su-{{ suid }}">Email</label>
  <input type="email" id="su-{{ suid }}" name="email" placeholder="Your email" required>
  <button type="submit">Get my deals</button>
  <p class="signup-note">By subscribing you agree to receive our deal emails. Free, and you can unsubscribe anytime. <a href="/legal/privacy/">Privacy policy</a></p>
</form>
