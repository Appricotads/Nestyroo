<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}{% if title %} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="stylesheet" href="/css/style.css">
<link rel="icon" type="image/png" href="/images/uploads/nestyroo_favicon.png">
   {% if noindex %}<meta name="robots" content="noindex">{% endif %}
</head>
<body>
  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/" aria-label="Nestyroo home">   <img src="/images/uploads/nestyroo_logo.png" alt="Nestyroo logo"> </a>
      <nav class="nav">
        {% for c in categories %}<a href="/category/{{ c.slug }}/">{{ c.title }}</a>{% endfor %}
        <button type="button" class="btn-pill" data-open-capture>Get deals</button>
      </nav>
    </div>
  </header>

  <main>{{ content | safe }}</main>

  <footer class="site-footer">
    <div class="wrap">
      <nav class="footer-nav">
        <a href="/about/">About</a>
        <a href="/legal/privacy/">Privacy</a>
        <a href="/legal/terms/">Terms</a>
        <a href="/legal/affiliate-disclosure/">Affiliate disclosure</a>
        <a href="/legal/unsubscribe/">Unsubscribe</a>
        <a href="/contact/">Contact</a>
        <button type="button" class="link-button" data-open-consent>Cookie settings</button>
      </nav>
      <p>We may earn a commission from links on this site, at no extra cost to you.</p>
      <p>&copy; {{ currentYear }} {{ site.name }}</p>
    </div>
  </footer>

  {% include "capture-popup.njk" %}
  <script src="/css/capture.js" defer></script>
  {% include "cookie-consent.njk" %}
  <script src="/js/consent.js" data-ga-id="{{ site.gaMeasurementId }}" defer></script>
  <script>
    /* CMS invite and password links land on the homepage: send them to the editor,
       so the Netlify Identity script only loads on /admin/ and not for visitors. */
    if (/(invite|recovery|confirmation|email_change)_token=/.test(location.hash)) {
      location.replace("/admin/" + location.hash);
    }
  </script>
</body>
</html>
