---
layout: layouts/base.njk
---
<div class="wrap section">
  <p class="crumbs"><a href="/">Home</a>{% for c in categories %}{% if c.slug in tags %} / <a href="/category/{{ c.slug }}/">{{ c.title }}</a>{% endif %}{% endfor %}</p>
  <h1 class="post-title">{{ title }}</h1>
  <p class="post-meta">Updated {{ date | readableDate }}</p>
  <p class="disclosure-box">We may earn a commission if you buy through our links. <a href="/legal/affiliate-disclosure/">How we choose deals</a></p>

  <div class="post-layout">
    <article class="post">
      {% if image %}<img class="post-featured-image" src="{{ image }}" alt="{{ imageAlt or title }}">{% endif %}
      {{ content | safe }}
    </article>
    <aside class="sidebar">
      <div class="side-card">
        <b>Get family deals weekly</b>
        {% set suid = "side" %}{% include "signup-inline.njk" %}
      </div>
      <h3>Related guides</h3>
      <ul class="related">
        {% for p in collections.blog | limit(4) %}{% if p.url != page.url %}<li><a href="{{ p.url }}">{{ p.data.title }}</a></li>{% endif %}{% endfor %}
      </ul>
    </aside>
  </div>
</div>
