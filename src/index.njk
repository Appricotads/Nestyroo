---
layout: layouts/base.njk
title: Home
---
<section class="hero">
  <div class="wrap">
    <h1>{{ site.tagline }}</h1>
    <p>Baby gear, kids' essentials and honest savings tips for Australia, checked against price history before we share them.</p>
    {% set suid = "hero" %}{% include "signup-inline.njk" %}
  </div>
</section>

<div class="wrap section">
  <h2>Shop by stage</h2>
  <div class="tiles">
    {% for c in categories %}
      <a class="tile tint-{{ c.tint }}" href="/category/{{ c.slug }}/"><b>{{ c.title }}</b><span>{{ c.blurb }}</span></a>
    {% endfor %}
  </div>
</div>

<div class="wrap section">
  <h2>This week's picks</h2>
  <div class="cards">
    {% for post in collections.blog | limit(3) %}{% include "post-card.njk" %}{% endfor %}
  </div>
  <p><a href="/blog/">See all guides &rarr;</a></p>
</div>

<div class="wrap section">
  <h2>Coming up</h2>
  <div class="events">
    {% for e in events %}<div class="event"><b>{{ e.when }}</b><span>{{ e.name }}</span></div>{% endfor %}
  </div>
</div>
