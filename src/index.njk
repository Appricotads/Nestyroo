---
layout: layouts/base.njk
title: Home
---
<section class="hero">
  <h1>{{ site.tagline }}</h1>
  <p>Real deals, honest money tips, and seasonal sale guides for Australia and New Zealand — no fluff, just what's worth your time.</p>
</section>

<div class="wrap">
  <h2>Latest posts</h2>
  <ul class="post-list">
    {% for post in collections.blog | limit(6) %}
      <li>
        {% if post.data.image %}
          <img class="post-thumb" src="{{ post.data.image }}" alt="{{ post.data.imageAlt or post.data.title }}">
        {% endif %}
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p class="post-meta">{{ post.data.date | readableDate }}{% if post.data.tags %} · {{ post.data.tags | join(", ") }}{% endif %}</p>
        <p>{{ post.data.description }}</p>
      </li>
    {% endfor %}
  </ul>
  <p><a href="/blog/">See all posts &rarr;</a></p>
</div>
