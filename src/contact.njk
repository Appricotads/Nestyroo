---
layout: layouts/base.njk
title: Contact
permalink: /contact/
---
<div class="wrap">
  <h1>Contact us</h1>
  <p>Questions, deal tips, or partnership enquiries — send us a message below.</p>

  <form name="contact" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" class="capture-form">
    <input type="hidden" name="form-name" value="contact">
    <p class="hidden-field"><label>Don't fill this out: <input name="bot-field"></label></p>

    <label for="c-name">Name</label>
    <input type="text" id="c-name" name="name" required>

    <label for="c-email">Email</label>
    <input type="email" id="c-email" name="email" required>

    <label for="c-message">Message</label>
    <textarea id="c-message" name="message" rows="5" required style="width:100%; padding:10px 12px; border:1px solid var(--border); border-radius:6px; font-family:inherit; font-size:1rem;"></textarea>

    <button type="submit" style="margin-top:14px;">Send message</button>
  </form>
</div>
